# Copy this to .env for local development. Never commit the real .env.
API_KEY=change-me-in-development
HOST=127.0.0.1
PORT=8000
FILE_RETENTION_HOURS=24
CACHE_TTL_HOURS=24
RATE_LIMIT_PER_MINUTE=30
MAX_JOBS=10
MAX_JOBS_PER_HOUR=10
# OUTPUT_DIR defaults to ./output locally. Hosts with read-only filesystems use /tmp.
OUTPUT_DIR=output
# USE_PLAYWRIGHT_SOURCE=0 uses synthetic demo data. Set to 1 only with permission to automate Google Maps.
USE_PLAYWRIGHT_SOURCE=0
